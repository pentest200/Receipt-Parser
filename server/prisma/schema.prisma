generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Receipt {
  id        String     @id @default(uuid())
  merchant  String?
  date      String?
  currency  String?
  subtotal  Float?
  tax       Float?
  tip       Float?
  discount  Float?
  total     Float?
  lineItems LineItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model LineItem {
  id        String  @id @default(uuid())
  receiptId String
  name      String
  amount    Float
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}
